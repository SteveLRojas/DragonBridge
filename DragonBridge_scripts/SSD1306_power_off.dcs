REM: Initialize DragonBridge
NOP:
TEST: AA
SPI_SPEED: FF
SPI_MODE: 00
SPI_CHIPSEL: 01
I2C_SPEED: 00 7D

REM: Set Display Off
I2C_START:
I2C_WRITE: 78
I2C_AGENT_ACK:
I2C_WRITE: 00
I2C_AGENT_ACK:
I2C_WRITE: AE
I2C_AGENT_ACK:
I2C_STOP:

REM: Disable Charge Pump Regulator
I2C_START:
I2C_WRITE: 78
I2C_AGENT_ACK:
I2C_WRITE: 00
I2C_AGENT_ACK:
I2C_WRITE: 8D
I2C_AGENT_ACK:
I2C_WRITE: 10
I2C_AGENT_ACK:
I2C_STOP:
