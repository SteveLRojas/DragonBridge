REM: Initialize DragonBridge
NOP:
TEST: AA
SPI_SPEED: FF
SPI_MODE: 00
SPI_CHIPSEL: 01
I2C_SPEED: 00 3E

REM: Set Display Off
I2C_START:
I2C_WRITE: 78
I2C_AGENT_ACK:
I2C_WRITE: 00
I2C_AGENT_ACK:
I2C_WRITE: AE
I2C_AGENT_ACK:
I2C_STOP:

REM: Set Osc Frequency
I2C_START:
I2C_WRITE: 78
I2C_AGENT_ACK:
I2C_WRITE: 00
I2C_AGENT_ACK:
I2C_WRITE: D5
I2C_AGENT_ACK:
I2C_WRITE: 80
I2C_AGENT_ACK:
I2C_STOP:

REM: MUX Ratio
I2C_START:
I2C_WRITE: 78
I2C_AGENT_ACK:
I2C_WRITE: 00
I2C_AGENT_ACK:
I2C_WRITE: A8
I2C_AGENT_ACK:
I2C_WRITE: 2F
I2C_AGENT_ACK:
I2C_STOP:

REM: Display Offset
I2C_START:
I2C_WRITE: 78
I2C_AGENT_ACK:
I2C_WRITE: 00
I2C_AGENT_ACK:
I2C_WRITE: D3
I2C_AGENT_ACK:
I2C_WRITE: 00
I2C_AGENT_ACK:
I2C_STOP:

REM: Display Start Line
I2C_START:
I2C_WRITE: 78
I2C_AGENT_ACK:
I2C_WRITE: 00
I2C_AGENT_ACK:
I2C_WRITE: 40
I2C_AGENT_ACK:
I2C_STOP:

REM: Set Memory Addressing Mode
I2C_START:
I2C_WRITE: 78
I2C_AGENT_ACK:
I2C_WRITE: 00
I2C_AGENT_ACK:
I2C_WRITE: 20
I2C_AGENT_ACK:
I2C_WRITE: 00
I2C_AGENT_ACK:
I2C_STOP:

REM: Segment re-map
I2C_START:
I2C_WRITE: 78
I2C_AGENT_ACK:
I2C_WRITE: 00
I2C_AGENT_ACK:
I2C_WRITE: A1
I2C_AGENT_ACK:
I2C_STOP:

REM: COM Output Scan Direction
I2C_START:
I2C_WRITE: 78
I2C_AGENT_ACK:
I2C_WRITE: 00
I2C_AGENT_ACK:
I2C_WRITE: C8
I2C_AGENT_ACK:
I2C_STOP:

REM: COM Pins Hardware Configuration
I2C_START:
I2C_WRITE: 78
I2C_AGENT_ACK:
I2C_WRITE: 00
I2C_AGENT_ACK:
I2C_WRITE: DA
I2C_AGENT_ACK:
I2C_WRITE: 12
I2C_AGENT_ACK:
I2C_STOP:

REM: Contrast Control
I2C_START:
I2C_WRITE: 78
I2C_AGENT_ACK:
I2C_WRITE: 00
I2C_AGENT_ACK:
I2C_WRITE: 81
I2C_AGENT_ACK:
I2C_WRITE: 7F
I2C_AGENT_ACK:
I2C_STOP:

REM: Set Pre-charge Period
I2C_START:
I2C_WRITE: 78
I2C_AGENT_ACK:
I2C_WRITE: 00
I2C_AGENT_ACK:
I2C_WRITE: D9
I2C_AGENT_ACK:
I2C_WRITE: 22
I2C_AGENT_ACK:
I2C_STOP:

REM: Entire Display On
I2C_START:
I2C_WRITE: 78
I2C_AGENT_ACK:
I2C_WRITE: 00
I2C_AGENT_ACK:
I2C_WRITE: A4
I2C_AGENT_ACK:
I2C_STOP:

REM: Set Normal Display
I2C_START:
I2C_WRITE: 78
I2C_AGENT_ACK:
I2C_WRITE: 00
I2C_AGENT_ACK:
I2C_WRITE: A6
I2C_AGENT_ACK:
I2C_STOP:

REM: Enable Charge Pump Regulator
I2C_START:
I2C_WRITE: 78
I2C_AGENT_ACK:
I2C_WRITE: 00
I2C_AGENT_ACK:
I2C_WRITE: 8D
I2C_AGENT_ACK:
I2C_WRITE: 14
I2C_AGENT_ACK:
I2C_STOP:

REM: Display on
I2C_START:
I2C_WRITE: 78
I2C_AGENT_ACK:
I2C_WRITE: 00
I2C_AGENT_ACK:
I2C_WRITE: AF
I2C_AGENT_ACK:
I2C_STOP:

REM: Set Column Address
I2C_START:
I2C_WRITE: 78
I2C_AGENT_ACK:
I2C_WRITE: 00
I2C_AGENT_ACK:
I2C_WRITE: 21
I2C_AGENT_ACK:
I2C_WRITE: 20
I2C_AGENT_ACK:
I2C_WRITE: 5F
I2C_AGENT_ACK:
I2C_STOP:

REM: Set Page Address
I2C_START:
I2C_WRITE: 78
I2C_AGENT_ACK:
I2C_WRITE: 00
I2C_AGENT_ACK:
I2C_WRITE: 22
I2C_AGENT_ACK:
I2C_WRITE: 00
I2C_AGENT_ACK:
I2C_WRITE: 05
I2C_AGENT_ACK:
I2C_STOP:

REM: Turn on 8x8 square on top left
I2C_START:
I2C_WRITE: 78
I2C_AGENT_ACK:
I2C_WRITE: 40
I2C_AGENT_ACK:
I2C_WRITE: FF
I2C_WRITE: FF
I2C_WRITE: FF
I2C_WRITE: FF
I2C_WRITE: FF
I2C_WRITE: FF
I2C_WRITE: FF
I2C_WRITE: FF
I2C_STOP:

REM: Turn off 8x8 square next to the previous one
I2C_START:
I2C_WRITE: 78
I2C_AGENT_ACK:
I2C_WRITE: 40
I2C_AGENT_ACK:
I2C_WRITE: 00
I2C_WRITE: 00
I2C_WRITE: 00
I2C_WRITE: 00
I2C_WRITE: 00
I2C_WRITE: 00
I2C_WRITE: 00
I2C_WRITE: 00
I2C_STOP:

REM: Switch to page 1
I2C_START:
I2C_WRITE: 78
I2C_AGENT_ACK:
I2C_WRITE: 00
I2C_AGENT_ACK:
I2C_WRITE: 22
I2C_AGENT_ACK:
I2C_WRITE: 01
I2C_AGENT_ACK:
I2C_WRITE: 05
I2C_AGENT_ACK:
I2C_STOP:

REM: Back to first column
I2C_START:
I2C_WRITE: 78
I2C_AGENT_ACK:
I2C_WRITE: 00
I2C_AGENT_ACK:
I2C_WRITE: 21
I2C_AGENT_ACK:
I2C_WRITE: 20
I2C_AGENT_ACK:
I2C_WRITE: 5F
I2C_AGENT_ACK:
I2C_STOP:

REM: Turn off 8x8 square below the first one
I2C_START:
I2C_WRITE: 78
I2C_AGENT_ACK:
I2C_WRITE: 40
I2C_AGENT_ACK:
I2C_WRITE: 00
I2C_WRITE: 00
I2C_WRITE: 00
I2C_WRITE: 00
I2C_WRITE: 00
I2C_WRITE: 00
I2C_WRITE: 00
I2C_WRITE: 00
I2C_STOP:

REM: Turn on 8x8 square diagonal from the first one
I2C_START:
I2C_WRITE: 78
I2C_AGENT_ACK:
I2C_WRITE: 40
I2C_AGENT_ACK:
I2C_WRITE: FF
I2C_WRITE: FF
I2C_WRITE: FF
I2C_WRITE: FF
I2C_WRITE: FF
I2C_WRITE: FF
I2C_WRITE: FF
I2C_WRITE: FF
I2C_STOP:
