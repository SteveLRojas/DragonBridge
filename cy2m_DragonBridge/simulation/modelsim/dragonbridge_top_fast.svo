`timescale 1 ps/ 1 ps

module dragonbridge_top (
	clk,
	rst_n,
	led,
	rxd,
	txd,
	cs_n,
	sck,
	mosi,
	miso,
	i2c_sda,
	i2c_scl);
input 	clk;
input 	rst_n;
output 	[2:0] led;
input 	rxd;
output 	txd;
output 	cs_n;
output 	sck;
output 	mosi;
input 	miso;
inout 	i2c_sda;
inout 	i2c_scl;

// Design Ports Information
// i2c_sda	=>  Location: PIN_72,	 I/O Standard: 3.3-V LVTTL,	 Current Strength: 20mA
// i2c_scl	=>  Location: PIN_71,	 I/O Standard: 3.3-V LVTTL,	 Current Strength: 20mA
// led[0]	=>  Location: PIN_3,	 I/O Standard: 3.3-V LVTTL,	 Current Strength: 20mA
// led[1]	=>  Location: PIN_7,	 I/O Standard: 3.3-V LVTTL,	 Current Strength: 20mA
// led[2]	=>  Location: PIN_9,	 I/O Standard: 3.3-V LVTTL,	 Current Strength: 20mA
// txd	=>  Location: PIN_142,	 I/O Standard: 3.3-V LVTTL,	 Current Strength: 20mA
// cs_n	=>  Location: PIN_40,	 I/O Standard: 3.3-V LVTTL,	 Current Strength: 20mA
// sck	=>  Location: PIN_41,	 I/O Standard: 3.3-V LVTTL,	 Current Strength: 20mA
// mosi	=>  Location: PIN_43,	 I/O Standard: 3.3-V LVTTL,	 Current Strength: 20mA
// rxd	=>  Location: PIN_143,	 I/O Standard: 3.3-V LVTTL,	 Current Strength: Default
// clk	=>  Location: PIN_17,	 I/O Standard: 3.3-V LVTTL,	 Current Strength: Default
// rst_n	=>  Location: PIN_144,	 I/O Standard: 3.3-V LVTTL,	 Current Strength: Default
// miso	=>  Location: PIN_42,	 I/O Standard: 3.3-V LVTTL,	 Current Strength: Default


wire gnd;
wire vcc;
wire unknown;

assign gnd = 1'b0;
assign vcc = 1'b1;
assign unknown = 1'bx;

tri1 devclrn;
tri1 devpor;
tri1 devoe;
